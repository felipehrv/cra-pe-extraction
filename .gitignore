.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.DS_Store

# Corpus PDFs and text are fetched on demand; gold-set PDFs are committed explicitly.
data/pdfs/
data/text/
data/cache/
!data/gold/
!data/gold/**

# Corpus-scale per-field dumps and stage logs are regenerated by make rules / make baseline;
# summary tables under results/ are committed.
results/*.log
results/rules*.csv
results/predictions_corpus*.csv
results/run_log_*.jsonl

# Smoke-test traces are throwaway; gold and corpus traces are committed.
data/traces/smoke/

# R session history
.Rhistory
